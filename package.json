    "@zxing/library": "^0.21.3",
    "axios": "^1.13.2",
    "cron-parser": "^5.5.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.19",
    "dexie": "^4.2.1",
    "diff": "^8.0.3",
    "html-to-image": "^1.11.13",
    "install": "^0.13.0",
